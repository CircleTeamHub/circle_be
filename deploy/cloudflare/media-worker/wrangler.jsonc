{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "windnote-media-preprod-delivery",
  "main": "src/index.js",
  "account_id": "0bea489023c1d8692a19dadaf15dcf95",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "windnote-media-preprod" },
  ],
  "ratelimits": [
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "932561105",
      "simple": { "limit": 200, "period": 10 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
