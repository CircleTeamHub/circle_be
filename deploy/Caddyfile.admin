{
	email {$ACME_EMAIL}
}

# ⚠️ 不要给下面的站点开 access log（`log` 指令）。历史上曾有把凭证放进 WS 握手
#    URL query 的通道经此反代;自研栈 token 走 socket.io auth payload 不落 URL，
#    但媒体预签名 URL 仍带签名 query —— 开日志前务必先过滤 query。

{$API_DOMAIN} {
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	# /readyz 报告数据库/Redis 是否可用,只服务于容器内探针与编排 —— compose 的
	# healthcheck 直连 127.0.0.1:3000,不经过 Caddy,所以这里 404 不影响探活,
	# 但能避免把依赖故障状态泄露给公网。/healthz 只回存活、不含依赖信息,保持
	# 公开以便外部 uptime 监控使用。
	@readyz path /readyz /readyz/*
	handle @readyz {
		respond 404
	}

	handle /circle/* {
		reverse_proxy minio:9000
	}

	# 自研 chat 网关(socket.io,/chat-ws)与 /realtime 原生 WS 都挂在 circle_be
	# 同一 HTTP 端口,由下面的 catch-all 反代;reverse_proxy 自动处理 WS 升级。
	handle {
		reverse_proxy {$CIRCLE_BE_UPSTREAM:circle-be-blue:3000}
	}
}

{$ADMIN_DOMAIN} {
	handle /api/* {
		reverse_proxy {$CIRCLE_BE_UPSTREAM:circle-be-blue:3000}
	}

	handle {
		reverse_proxy admin_web:80
	}
}
