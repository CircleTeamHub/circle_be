{
	email {$ACME_EMAIL}

	# rate_limit 由 Dockerfile.caddy 编进来（官方镜像没有）。它是 HTTP handler，
	# 必须在 order 里给出相对位置，否则 Caddy 起不来。放在 reverse_proxy 之前：
	# 超限的请求要在打到上游之前就被挡下，否则限流毫无意义。
	order rate_limit before reverse_proxy
}

# ── 限流说明 ──────────────────────────────────────────────────────────────────
# 各 handle 块里的 rate_limit 都按 {remote_host}（对端 IP）计数。compose 把 80/443
# 直接映射到本机、前面没有 CDN/代理，所以 {remote_host} 就是真实客户端 IP；哪天
# 挪到 Cloudflare 之类后面，必须同时配 trusted_proxies，否则所有人会共用一个桶。
#
# ⚠️ 不要给下面的整个站点开 access log（`log` 指令）。API 域只给 /chat-ws 分配
#    no_hostname 的专用 logger，并在输出前移除 query、请求头和 IP；媒体预签名 URL
#    及普通 API 请求仍不会进入 Caddy access log。

{$API_DOMAIN} {
	# 只记录 chat WebSocket 握手。连接追踪 ID 由客户端随机生成，不含账号；
	# query、全部请求头和 IP 在编码前删除，避免 token、签名 URL 或设备信息落盘。
	@chat_ws path /chat-ws /chat-ws/*
	@chat_ws_traced {
		path /chat-ws /chat-ws/*
		header_regexp connection_trace X-Connection-Trace-Id ^ws-[a-zA-Z0-9-]{8,96}$
	}
	log chat_ws {
		no_hostname
		output stdout
		# filter 编码器的字段过滤必须放在 fields 块里(Caddy 2.8+ 语法);直接写在
		# format filter 下的旧写法会被 caddy validate 拒绝,release-deploy.sh 每次
		# 切流前都会跑 validate,配置不合法就等于发布被卡死。
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
			}
		}
	}
	log_name @chat_ws chat_ws
	log_append @chat_ws event ws_proxy_access
	log_append @chat_ws_traced traceId {http.request.header.X-Connection-Trace-Id}

	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	# /readyz 报告数据库/Redis 是否可用,只服务于容器内探针与编排 —— compose 的
	# healthcheck 直连 127.0.0.1:3000,不经过 Caddy,所以这里 404 不影响探活,
	# 但能避免把依赖故障状态泄露给公网。/healthz 只回存活、不含依赖信息,保持
	# 公开以便外部 uptime 监控使用。
	@readyz path /readyz /readyz/*
	handle @readyz {
		respond 404
	}

	# MinIO 媒体直读。这里必须有限流，理由和别处不同：avatars / covers / posts /
	# chat / friends / uploads 这些前缀是**匿名可读**的（upload.service.ts 的
	# buildPublicReadBucketPolicy，Principal: '*'），而这条路由在 Caddy 就转给了
	# MinIO，根本不经过 Node —— 应用层那套限流（300/min/IP 的 express 兜底、
	# @Throttle）一条都作用不到。
	# 也就是说：任何人拿到一张头像 URL（在 app 里随手可见），就能无账号、无令牌地
	# 无限次拉取。攻击成本是一次上传，代价是运营方的出网带宽账单，同时和 Postgres、
	# Redis、MinIO 抢同一台机器。
	# 额度给得比接口宽：一屏朋友圈就可能几十张图，但必须封顶。
	handle /circle/* {
		rate_limit {
			zone minio_media {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy minio:9000
	}

	# 自研 chat 网关(socket.io,/chat-ws)与 /realtime 原生 WS 都挂在 circle_be
	# 同一 HTTP 端口,由下面的 catch-all 反代;reverse_proxy 自动处理 WS 升级。
	handle {
		# 业务 API 的兜底闸。circle_be 自己有每 IP 300 次/分钟的全局限流
		# （src/setup.ts），这里放宽到 600 只做 DoS 兜底：真正的业务额度由后端
		# 判定（它认得账号，这里只认 IP），网关这层的职责是别让洪泛打到 Node 进程。
		rate_limit {
			zone api_fallback {
				key {remote_host}
				events 600
				window 1m
			}
		}
		reverse_proxy {$CIRCLE_BE_UPSTREAM:circle-be-blue:3000}
	}
}

{$ADMIN_DOMAIN} {
	# 管理域同样要限流：它把后端整个 API 也暴露在另一个域名下（/api/*），
	# 只在 API_DOMAIN 那边限流等于留了一扇没上锁的后门 —— 攻击者换个 Host 就绕过。
	# 管理台用户少、操作频次低，额度可以比主域紧。
	handle /api/* {
		rate_limit {
			zone admin_api {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy {$CIRCLE_BE_UPSTREAM:circle-be-blue:3000}
	}

	handle {
		rate_limit {
			zone admin_web {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy admin_web:80
	}
}
