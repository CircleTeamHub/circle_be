logging {
  level  = "warn"
  format = "json"
}

loki.source.file "circle" {
  targets = [{
    __path__         = "/var/log/circle/{blue,green}/application-*.log*",
    __path_exclude__ = "/var/log/circle/**/*.gz",
    service         = "circle-be",
    environment     = sys.env("LOG_ENVIRONMENT"),
  }]
  file_match {
    enabled     = true
    sync_period = "5s"
  }
  forward_to = [loki.process.circle.receiver]
}

loki.process "circle" {
  stage.json {
    expressions = { level = "level", timestamp = "timestamp" }
    // Keep legacy text lines during the binary rollback compatibility window.
    // They receive level=unknown below instead of disappearing from Loki.
    drop_malformed = false
  }
  stage.labels {
    values = { level = "level" }
  }
  stage.match {
    selector = "{level!~\"error|warn|info|http|verbose|debug|silly\"}"
    // Pre-sanitizer rollback images can emit arbitrary prose. Keep a safe
    // occurrence marker for rollback visibility, never the untrusted content.
    stage.replace {
      expression = ".+"
      replace    = "legacy rollback log content redacted by collector"
    }
    stage.static_labels {
      values = { level = "unknown" }
    }
  }
  stage.timestamp {
    source            = "timestamp"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }
  // File paths, release/container identities and correlation IDs must never
  // become index labels. The safe JSON line stays available to `| json`.
  stage.label_keep {
    values = ["service", "environment", "level"]
  }
  forward_to = [loki.write.local.receiver]
}

// Caddy 自己落盘的脱敏副本（deploy/Caddyfile.admin 全局块的 log collected）。
// 只跟活动文件：滚动出去的旧文件换了名字，再匹配一次就会整份重读、重复入库。
loki.source.file "caddy" {
  targets = [{
    __path__    = "/var/log/caddy/collected.log",
    service     = "caddy",
    environment = sys.env("LOG_ENVIRONMENT"),
  }]
  file_match {
    enabled     = true
    sync_period = "5s"
  }
  forward_to = [loki.process.caddy.receiver]
}

loki.process "caddy" {
  stage.json {
    expressions = { level = "level", ts = "ts" }
    drop_malformed = false
  }
  stage.labels {
    values = { level = "level" }
  }
  stage.timestamp {
    source            = "ts"
    format            = "Unix"
    action_on_failure = "skip"
  }
  // 与应用日志同一套索引标签；logger、traceId 等留在行里，用 `| json` 查。
  stage.label_keep {
    values = ["service", "environment", "level"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    min_backoff_period  = "1s"
    max_backoff_period  = "30s"
    max_backoff_retries = 20
  }
  wal {
    enabled         = true
    max_segment_age = "1h"
  }
}
