{
  "uid": "circle-be-operations",
  "title": "circle_be — Operations Overview",
  "tags": ["circle", "backend", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "name": "发版",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "expr": "max by (version, commit) (circle_build_info{job=\"circle-be\"}) unless max by (version, commit) (circle_build_info{job=\"circle-be\"} offset 5m)"
        },
        "step": "60s",
        "titleFormat": "发版 {{version}}",
        "textFormat": "commit {{commit}}",
        "tagKeys": "version",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active firing alerts",
      "description": "Current Prometheus firing alerts grouped by name and severity. This shows rule state, not whether any notification was received.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "No firing alerts", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (alertname, severity) (ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"})", "legendFormat": "{{severity}} · {{alertname}}", "instant": true }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Current health of configured scrape targets (1 up, 0 down). A missing optional exporter produces No data instead of a synthetic healthy value.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "min by (job, instance) (up)", "legendFormat": "{{job}} · {{instance}}", "instant": true }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alertmanager notification attempt failures (10m)",
      "description": "Failed Alertmanager delivery attempts by integration over 10 minutes. Zero failures does not prove that a receiver accepted or acted on a notification.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (integration) (increase(alertmanager_notifications_failed_total[10m]))", "legendFormat": "{{integration}}" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alertmanager config reload",
      "description": "Last Alertmanager configuration reload result (1 successful, 0 failed). No data means Alertmanager self-metrics are unavailable.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "min(alertmanager_config_last_reload_successful)", "legendFormat": "reload successful", "instant": true }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prometheus rule evaluation errors (10m)",
      "description": "Prometheus rule evaluation failures over 10 minutes. These can prevent alerts from entering the delivery pipeline independently of application traffic.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (rule_group) (increase(prometheus_rule_evaluation_failures_total[10m]))", "legendFormat": "{{rule_group}}" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Public probe success",
      "description": "Current blackbox HTTP probe result (1 successful, 0 failed). Production probe targets are optional; an unconfigured target file correctly shows No data.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "noValue": "No data", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "min by (component, instance) (probe_success{job=\"blackbox-http\"})", "legendFormat": "{{component}} · {{instance}}", "instant": true }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Public TLS certificate lifetime",
      "description": "Remaining TLS certificate lifetime for public probes. No data is expected when optional production probe targets are not configured.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "asc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "min by (component, instance) (probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time())", "legendFormat": "{{component}} · {{instance}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host memory used",
      "description": "Memory utilisation from node_exporter in the base monitoring stack. No data means the exporter or its scrape target is unavailable.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Writable host filesystem used",
      "description": "Used capacity on writable host filesystems from node_exporter in the base monitoring stack. Read-only and image filesystems are excluded; No data means the exporter or its scrape target is unavailable.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs|zfs|ext3\",mountpoint!~\"/(boot|snap)(/.*)?\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs|btrfs|zfs|ext3\",mountpoint!~\"/(boot|snap)(/.*)?\"}) and on(instance, mountpoint, device) node_filesystem_readonly == 0", "legendFormat": "{{instance}} · {{mountpoint}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Alloy log delivery retry and drop rates",
      "description": "Optional Alloy log delivery retries and dropped entries per second. Metrics-only installs correctly show No data; absence is not converted into a healthy zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "noValue": "No data" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(loki_write_batch_retries_total[5m]))", "legendFormat": "retries" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(loki_write_dropped_entries_total[5m]))", "legendFormat": "dropped entries" }
      ]
    },
    {"id": 11, "type": "timeseries", "title": "Gateway budget utilisation", "description": "Per-process HTTP work, total sockets and pending authentication budgets. Each pool is enforced independently; No data means the new metrics are unavailable.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "noValue": "No data"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "circle_gateway_capacity_used / circle_gateway_capacity_limit", "legendFormat": "{{instance}} · {{pool}}"}]},
    {"id": 12, "type": "timeseries", "title": "Gateway capacity rejections and auth timeouts", "description": "Protection events per second. A spike can reflect an attack, insufficient capacity or client retries; inspect before blocking clients.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "noValue": "No data"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance, pool, reason) (rate(circle_gateway_rejections_total[5m]))", "legendFormat": "{{instance}} · {{pool}} · {{reason}}"}]},
    {"id": 13, "type": "timeseries", "title": "API authentication and rate-limit responses", "description": "Responses observed by NestJS. Requests rejected by Caddy before reaching NestJS are not included. No data is not proof that the edge is quiet.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "noValue": "No data"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status_code) (rate(http_requests_total{job=\"circle-be\",status_code=~\"401|403|429|503\"}[5m]))", "legendFormat": "{{status_code}}"}]},
    {"id": 14, "type": "stat", "title": "Synthetic probe: time since last full pass", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 36}, "fieldConfig": {"defaults": {"unit": "s", "noValue": "Probe not configured or not running", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 600}, {"color": "red", "value": 900}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - max(circle_synthetic_probe_last_success_timestamp_seconds{job=\"synthetic-probe\"}) and on() max(circle_synthetic_probe_configured{job=\"synthetic-probe\"}) == 1", "legendFormat": "since last pass", "instant": true}], "description": "A dedicated test account refreshes its token, lists conversations and reaches /realtime ready every 5 minutes through the public URL. Red at 15 minutes = SyntheticProbeFailing. No data means the probe container is not running or has no .env.synthetic-probe (SyntheticProbeNotConfigured)."},
    {"id": 15, "type": "timeseries", "title": "Synthetic probe step durations", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 8, "y": 36}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (step) (circle_synthetic_probe_step_duration_seconds{job=\"synthetic-probe\"})", "legendFormat": "{{step}}"}], "description": "Last run of each step: auth (token reuse, refresh or login), api (conversation list), realtime (connect, authenticate, first badge snapshot). A step that keeps growing usually fails next."},
    {"id": 16, "type": "timeseries", "title": "Synthetic probe failures by step and reason (1h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 16, "y": 36}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (step, reason) (increase(circle_synthetic_probe_failures_total{job=\"synthetic-probe\"}[1h]))", "legendFormat": "{{step}} · {{reason}}"}], "description": "Where runs fail and why. auth/login_rejected or device_verification_required are the probe account itself; api/http_5xx, realtime/no_snapshot or ws_closed_* point at the backend. The runbook entry for SyntheticProbeFailing lists every reason."},
    {"id": 17, "type": "stat", "title": "Running backend builds", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 24, "x": 0, "y": 42}, "fieldConfig": {"defaults": {"unit": "short", "noValue": "No backend instance", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "none", "textMode": "name", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (instance, version, commit) (circle_build_info{job=\"circle-be\"})", "legendFormat": "{{instance}} · {{version}} · {{commit}}", "instant": true}], "description": "Which build each backend instance runs (version from SENTRY_RELEASE, commit baked into the image). Two different builds for more than 30 minutes = BackendVersionSkew: a blue-green release stopped half way. unknown means a hand-built image or a host deployed without the release script."}
  ]
}
