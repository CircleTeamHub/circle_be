{
  "uid": "circle-be-deliveries",
  "title": "circle_be — Deliveries, Dependencies & Business",
  "tags": [
    "circle-be",
    "deliveries"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "发版",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "expr": "max by (version, commit) (circle_build_info{job=\"circle-be\"}) unless max by (version, commit) (circle_build_info{job=\"circle-be\"} offset 5m)"
        },
        "step": "60s",
        "titleFormat": "发版 {{version}}",
        "textFormat": "commit {{commit}}",
        "tagKeys": "version",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Object store reachable",
      "description": "1 when every serving backend instance answers HeadBucket (cached 30s). 0 here is what ObjectStoreUnreachable pages on.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(circle_object_store_up{job=\"circle-be\"})",
          "legendFormat": "object store",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unhandled rejections (15m)",
      "description": "Promise rejections caught by the process guard in the last 15m — a missing .catch. Find the call chain in Loki: [unhandledRejection].",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(circle_unhandled_rejections_total{job=\"circle-be\"}[15m]))",
          "legendFormat": "rejections",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Email code send failure ratio (15m)",
      "description": "Share of verification-code emails that failed or found no mailer. EmailCodeSendFailing pages above 50% with at least 3 failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(circle_email_code_sends_total{job=\"circle-be\",result=~\"failure|unavailable\"}[15m])) / sum(rate(circle_email_code_sends_total{job=\"circle-be\"}[15m])) and sum(rate(circle_email_code_sends_total{job=\"circle-be\"}[15m])) > 0",
          "legendFormat": "failure ratio",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backups: last release off-host copy",
      "description": "1 if the last release-time encrypted pg_dump reached the off-host bucket (written by the release script into the backup metrics volume).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(circle_release_offsite_backup_success)",
          "legendFormat": "release off-host backup",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Push deliveries by provider and result",
      "description": "Per-token outcomes. dead_token is normal churn (uninstalled apps), not a failure; Expo receipt-stage failures are counted again because expired credentials only show up there.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, result) (rate(circle_push_deliveries_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "{{provider}} · {{result}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Push failure ratio by provider (15m)",
      "description": "retryable + rejected over terminal outcomes, counted once per token attempt — the same ratio PushDeliveryFailing alerts on above 20%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (rate(circle_push_delivery_terminal_total{job=\"circle-be\",result=~\"retryable|rejected\"}[15m])) / sum by (provider) (rate(circle_push_delivery_terminal_total{job=\"circle-be\"}[15m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dependency requests by result",
      "description": "Backend requests to object storage (every HTTP attempt; presigning excluded) and LiveKit. not_found is a normal missing-object answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (dependency, result) (rate(circle_dependency_requests_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "{{dependency}} · {{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dependency failure ratio (15m)",
      "description": "Failures over all requests, excluding the HeadBucket reachability probe — the same ratio DependencyRequestsFailing alerts on above 20%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (dependency) (rate(circle_dependency_requests_total{job=\"circle-be\",operation!=\"HeadBucket\",result=\"failure\"}[15m])) / sum by (dependency) (rate(circle_dependency_requests_total{job=\"circle-be\",operation!=\"HeadBucket\"}[15m]))",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Object storage requests by operation",
      "description": "Which server-side storage operations run and which fail. Useful to see a bucket policy rejecting one operation (e.g. CopyObject) while others succeed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operation, result) (rate(circle_dependency_requests_total{job=\"circle-be\",dependency=\"object_storage\"}[5m]))",
          "legendFormat": "{{operation}} · {{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Verification-code emails by result",
      "description": "success / failure / unavailable (no mailer configured). Anti-enumeration silent skips are not sends and are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(circle_email_code_sends_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Business events by result",
      "description": "App-domain events (login, coin gift, …) incremented whenever a business event is logged. A sudden failure share on one event is usually a regression in that flow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, result) (rate(business_events_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "{{event}} · {{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Upload presigns by result",
      "description": "Presign requests by result. failure includes user-side rejections such as quota exhaustion, which is why there is no alert on it; watch the trend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(upload_presign_requests_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (store) (rate(upload_presign_rate_limited_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "rate limited · {{store}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Upload bytes authorized",
      "description": "Bytes authorized by successful presigns (client uploads go straight to storage, so this is the backend's view of upload volume).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(upload_presign_issued_bytes_total{job=\"circle-be\"}[5m]))",
          "legendFormat": "bytes/s"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Call server-side failure ratio (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No calls",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(circle_call_setups_total{job=\"circle-be\",result=~\"livekit_unavailable|failed\"}[15m])) + sum(increase(circle_call_accepts_total{job=\"circle-be\",result=\"failed\"}[15m]))) / (sum(increase(circle_call_setups_total{job=\"circle-be\"}[15m])) + sum(increase(circle_call_accepts_total{job=\"circle-be\"}[15m]))) and (sum(increase(circle_call_setups_total{job=\"circle-be\"}[15m])) + sum(increase(circle_call_accepts_total{job=\"circle-be\"}[15m]))) > 0",
          "legendFormat": "failure ratio",
          "instant": true
        }
      ],
      "description": "Call starts and answers that failed on the server (LiveKit unavailable or errors) over all attempts. Busy and too-late answers are normal outcomes and only count in the denominator. 20% is the CallSetupFailing threshold (with at least 5 attempts)."
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Answered calls ending within 10s (30m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No answered calls",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(circle_call_answered_duration_seconds_bucket{job=\"circle-be\",le=\"10\"}[30m])) / sum(increase(circle_call_answered_duration_seconds_count{job=\"circle-be\"}[30m])) and sum(increase(circle_call_answered_duration_seconds_count{job=\"circle-be\"}[30m])) > 0",
          "legendFormat": "ended within 10s",
          "instant": true
        }
      ],
      "description": "Signalling worked but the call was over almost at once — usually media never connected and people hung up. 60% is the CallsEndingTooQuickly threshold (with at least 5 answered calls). Calls that end through LiveKit room_finished include its departure timeout, so drop-outs are under-counted here."
    },
    {
      "id": 16,
      "type": "stat",
      "title": "LiveKit webhooks failed or rejected (30m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(circle_call_livekit_webhooks_total{job=\"circle-be\",result=~\"failed|rejected\"}[30m]))",
          "legendFormat": "{{result}}",
          "instant": true
        }
      ],
      "description": "failed = a correctly signed event that threw while processing (answered 500, LiveKit retries); rejected = signature check failed. Rejections while handled events keep flowing are scanners; only rejected with nothing handled raises LiveKitWebhookRejected."
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Calls started (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
