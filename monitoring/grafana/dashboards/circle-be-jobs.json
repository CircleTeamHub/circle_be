        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "队列积压（仍会重试）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_pending)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "最老待处理行的滞留时长",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_oldest_age_seconds)",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "队列到底有没有在排空 —— 比积压量更直接。红线 900s = OutboxBacklogStuck。\n\ngift_card 稳态下会在 ~120s 附近浮动：处理器有 2 分钟宽限期才补发，属正常。"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "死信存量（永不重试）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_dead)",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "只增不减的存量，所以告警用的是 delta（过去 1 小时新增），这里看的是累计。\n\ngift_card 上的每一条都意味着：钱已结算但转账卡永久丢失，需要人工对账（UPDATE \"CoinGift\" SET \"cardAttempts\"=0 可安全重发，clientMessageId 幂等）。"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "死信新增速率（1h）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (delta(circle_outbox_dead[1h]))",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "OutboxDeadLettersAppearing / GiftCardPermanentlyLost 看的就是这条。"
    },
    {
      "id": 11,
      "type": "row",
      "title": "连接池 · Postgres 看不见的那一面",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "pg 连接池",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_waiting)",
          "legendFormat": "waiting（排队等连接）"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_total)",
          "legendFormat": "total（已建立）"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_idle)",
          "legendFormat": "idle（空闲）"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_max)",
          "legendFormat": "max（配置上限）"
        }
      ],
      "description": "**waiting > 0 就是池成为瓶颈的确定信号**，而这时 Postgres 侧一切正常：连接数没涨、没有慢查询、没有锁等待。排队发生在 Node 进程内部。\n\n池默认只有 10（DATABASE_POOL_MAX），而圈子列表这类接口的 findMany + count 是并发发出的、一个请求就占两个连接。排队深度超过 5 持续 2 分钟 = DbPoolExhausted，后续请求会陆续撞上 10s 取连接超时变成 5xx。"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Postgres 连接数 / max_connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_database_numbackends) / max(pg_settings_max_connections)",
          "legendFormat": "使用率"
        }
      ],
      "description": "服务端视角的饱和度，和上面的连接池是**两件事**：池排空了这里也可能很低。\n\n两边都套 max() 是必须的 —— pg_settings_max_connections 带 server 标签而 pg_stat_database_numbackends 不带，直接相除会因标签不匹配恒为空。"
    },
    {
      "id": 14,
      "type": "row",
      "title": "数据存储 · Postgres / Redis",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Postgres 后端连接（按状态）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count)",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "idle in transaction 持续偏高 = 忘记提交的长事务，会一直占着连接名额。"
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis 内存占用率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_memory_used_bytes / (redis_memory_max_bytes > 0)",
          "legendFormat": "used / maxmemory"
        }
      ],
      "description": "生产 Redis 用的是 maxmemory-policy **noeviction**：撑到上限不会淘汰旧键，而是让写入直接报错。会话撤销依赖 Redis 写入，所以这等价于撤销静默失效 —— 阈值 90% 是 critical。\n\n分母加 > 0 是为了过滤未设 maxmemory 的情况，否则得到 +Inf 永远告警。"
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Redis 客户端数",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
