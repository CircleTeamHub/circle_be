{
  "uid": "circle-be-jobs",
  "title": "circle_be — Jobs, Queues & Datastores",
  "tags": [
    "circle_be",
    "jobs",
    "outbox",
    "datastores"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "发版",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "expr": "max by (version, commit) (circle_build_info{job=\"circle-be\"}) unless max by (version, commit) (circle_build_info{job=\"circle-be\"} offset 5m)"
        },
        "step": "60s",
        "titleFormat": "发版 {{version}}",
        "textFormat": "commit {{commit}}",
        "tagKeys": "version",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "定时任务 · Scheduled jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "任务心跳滞后（× 预期周期）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - max by (exported_job) (circle_cron_last_success_timestamp_seconds)) / max by (exported_job) (circle_cron_interval_seconds)",
          "legendFormat": "{{exported_job}}"
        }
      ],
      "description": "以各任务自己的预期周期归一化，所以每分钟任务和每天 4 点的任务能画在同一张图上。1.0 = 迟了一个周期；红线 3.0 = CronJobStalled 的告警阈值。\n\n心跳在进程启动时就播种，所以从没跑过的任务会从 0 开始持续爬升，而不是因为序列不存在而完全看不见。"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "任务失败率（15m）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exported_job) (rate(circle_cron_runs_total{result=\"failure\"}[15m])) / sum by (exported_job) (rate(circle_cron_runs_total{result!=\"skipped\"}[15m]))",
          "legendFormat": "{{exported_job}}"
        }
      ],
      "description": "分母排除 skipped（重入闸挡掉的调度不是一次执行，算进去会把卡死任务的失败率稀释成接近 0）。注意：4 个 outbox 处理器会自己 catch 异常并写进行上的 lastError，所以队列堵死时这张图可能一直是 0 —— 那种故障要看下面的积压和死信。"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "任务单次耗时",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (exported_job) (circle_cron_last_duration_seconds)",
          "legendFormat": "{{exported_job}}"
        }
      ],
      "description": "逼近自身周期就意味着下一轮会与本轮重叠（多数任务有重入闸，会直接跳过）。"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "任务执行速率（15m）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exported_job, result) (rate(circle_cron_runs_total[15m])) * 60",
          "legendFormat": "{{exported_job}} · {{result}}"
        }
      ],
      "description": "次/分钟，按结果拆开。掉到 0 而心跳不涨 = 调度器停了；整条线全变成 skipped = 上一轮吊死在里面、重入闸把后续每一次调度都挡掉了（心跳同时会停住，CronJobStalled 负责报出来）。"
    },
    {
      "id": 6,
      "type": "row",
      "title": "Outbox 队列 · 「活干不完」与「已放弃」",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "队列积压（仍会重试）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_pending)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "最老待处理行的滞留时长",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_oldest_age_seconds)",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "队列到底有没有在排空 —— 比积压量更直接。红线 900s = OutboxBacklogStuck。\n\ngift_card 稳态下会在 ~120s 附近浮动：处理器有 2 分钟宽限期才补发，属正常。"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "死信存量（永不重试）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_dead)",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "只增不减的存量，所以告警用的是 delta（过去 1 小时新增），这里看的是累计。\n\ngift_card 上的每一条都意味着：钱已结算但转账卡永久丢失，需要人工对账（UPDATE \"CoinGift\" SET \"cardAttempts\"=0 可安全重发，clientMessageId 幂等）。"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "死信新增速率（1h）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (circle_outbox_dead - min_over_time(circle_outbox_dead[1h]))",
          "legendFormat": "{{queue}}"
        }
      ],
      "description": "OutboxDeadLettersAppearing / GiftCardPermanentlyLost 看的就是这条。"
    },
    {
      "id": 11,
      "type": "row",
      "title": "连接池 · Postgres 看不见的那一面",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "pg 连接池",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_waiting)",
          "legendFormat": "waiting（排队等连接）"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_total)",
          "legendFormat": "total（已建立）"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_idle)",
          "legendFormat": "idle（空闲）"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circle_db_pool_max)",
          "legendFormat": "max（配置上限）"
        }
      ],
      "description": "**waiting > 0 就是池成为瓶颈的确定信号**，而这时 Postgres 侧一切正常：连接数没涨、没有慢查询、没有锁等待。排队发生在 Node 进程内部。\n\n池默认只有 10（DATABASE_POOL_MAX），而圈子列表这类接口的 findMany + count 是并发发出的、一个请求就占两个连接。排队深度超过 5 持续 2 分钟 = DbPoolExhausted，后续请求会陆续撞上 10s 取连接超时变成 5xx。"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Postgres 连接数 / max_connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_database_numbackends) / max(pg_settings_max_connections)",
          "legendFormat": "使用率"
        }
      ],
      "description": "服务端视角的饱和度，和上面的连接池是**两件事**：池排空了这里也可能很低。\n\n两边都套 max() 是必须的 —— pg_settings_max_connections 带 server 标签而 pg_stat_database_numbackends 不带，直接相除会因标签不匹配恒为空。"
    },
    {
      "id": 14,
      "type": "row",
      "title": "数据存储 · Postgres / Redis",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Postgres 后端连接（按状态）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count)",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "idle in transaction 持续偏高 = 忘记提交的长事务，会一直占着连接名额。"
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis 内存占用率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_memory_used_bytes / (redis_memory_max_bytes > 0)",
          "legendFormat": "used / maxmemory"
        }
      ],
      "description": "生产 Redis 用的是 maxmemory-policy **noeviction**：撑到上限不会淘汰旧键，而是让写入直接报错。会话撤销依赖 Redis 写入，所以这等价于撤销静默失效 —— 阈值 90% 是 critical。\n\n分母加 > 0 是为了过滤未设 maxmemory 的情况，否则得到 +Inf 永远告警。"
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Redis 客户端数",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_connected_clients",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Redis 被拒连接（10m 新增）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(redis_rejected_connections_total[10m])",
          "legendFormat": "rejected"
        }
      ],
      "description": "非 0 = 撞到 maxclients。"
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "最近一次运行失败的任务",
