# Caddy + rate_limit 模块。
#
# 官方 caddy:2-alpine 不带任何限流能力 —— 而 Caddy 是 API 域与 admin 域唯一的
# 公网入口。没有这个模块，反代到 circle_be 的 REST 与 /chat-ws 升级就是不限速、
# 不限连接数的裸转发（限流区见 deploy/Caddyfile.admin 的 api_fallback）。
#
# 固定模块版本，避免每次重建都拉到不同的上游提交。升级时同步改这里的 tag。
FROM caddy:2-builder-alpine AS builder
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.60.0 \
    --replace golang.org/x/text=golang.org/x/text@v0.42.0 \
    --replace golang.org/x/crypto=golang.org/x/crypto@v0.57.0 \
    --replace google.golang.org/grpc=google.golang.org/grpc@v1.83.2

# 运行阶段有名字，CI 才能对它关掉层缓存（ci.yml 的 no-cache-filters）：基础镜像
# 没更新时，带缓存的构建会一直沿用旧的 apk upgrade 结果，Alpine 已经修好的漏洞照样
# 让 Trivy 红。xcaddy 编译那一阶段照常走缓存。
FROM caddy:2-alpine AS runtime
RUN apk upgrade --no-cache
# 采集用日志副本的目录（Caddyfile 全局块的 log collected）。0755：caddy_logs 命名卷
# 首次挂载时继承它，以非 root 运行的 Alloy 才进得去。
RUN mkdir -p /var/log/caddy && chmod 0755 /var/log/caddy
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
