generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

/// 客服类型。前四类对应 App 客服中心的四个入口，membership 收编原先独立的
/// EXPO_PUBLIC_MEMBERSHIP_SUPPORT_USER_ID，不再让两套机制并存。
enum SupportAgentCategory {
  recharge
  issue
  dispute
  account
  membership
}

enum RefreshTokenAudience {
  APP
  ADMIN
}

enum RefreshTokenRevocationReason {
  ROTATED
  SINGLE_DEVICE_REPLACED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  OTHER_SESSIONS_REVOKED
  TOKEN_FAMILY_REUSE
}

enum EmailCodePurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

enum UserRole {
  ADMIN
  MEMBER
  USER
}

enum Gender {
  male
  female
  other
  unset
}

enum FriendState {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// How much of the owner's world a friend may see.
/// FULL = chat + moments; CHAT_ONLY = chat but hidden from the owner's moments.
enum FriendPermission {
  FULL
  CHAT_ONLY
}

enum FriendActivityType {
  REQUEST_RECEIVED
  REQUEST_SENT
  REQUEST_MESSAGE_RECEIVED
  REQUEST_ACCEPTED_BY_OTHER
  REQUEST_REJECTED_BY_OTHER
  REQUEST_ACCEPTED_BY_ME
  REQUEST_REJECTED_BY_ME
  REQUEST_WITHDRAWN_BY_OTHER
}

enum NoteStatus {
  ACTIVE
  UNLISTED
  DELETED
}

enum NoteMediaType {
  IMAGE
  VIDEO
}

enum CirclePostStatus {
  ACTIVE
  ENDED
  DELETED
}

enum CircleMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CircleMemberStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum FriendChatReplayStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationPushOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  TERMINAL
}

/// Per-(notification, device-token) delivery state (#88).
/// SENT = Expo accepted (ticket held); CONFIRMED = receipt ok or aged out;
/// FAILED = retryable, the outbox sweep will resend to this token only;
/// TERMINAL = token dead (DeviceNotRegistered etc.), never retried.
enum NotificationPushDeliveryStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  TERMINAL
}

enum IconAssetSourceType {
  SYSTEM
  CIRCLE
}

enum UserDisplayIconType {
  SYSTEM
  CIRCLE
}

enum SystemIconKey {
  VIP
  NEW_USER
  TOP_COLLABORATOR
  VERIFIED_PROFILE
  CIRCLE_BUILDER
  // Legacy value kept for databases that already applied the old PARTNER enum
  // migration. The service no longer emits or accepts this key.
  PARTNER
}

enum CircleCategory {
  LIFE
  FOOD
  SPORTS
  SOCIAL
  GAMING
  PHOTOGRAPHY
  WORK
  TRADE
  CUSTOM
}

enum CircleInvitationStatus {
  PENDING
  APPROVED
  REJECTED
  ADMIN_APPROVED
  CANCELLED
}

enum CircleInvitationVerifierStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TraceType {
  MOMENT
}

enum TraceVisibility {
  PRIVATE
  PUBLIC
  FRIENDS_ONLY
}

enum UserTracePreferenceType {
  HIDE
}

enum NotificationType {
  SQUAD_REQUEST_RECEIVED
  SQUAD_REQUEST_ACCEPTED
  SQUAD_REQUEST_REJECTED
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  FRIEND_REQUEST_REJECTED
  FRIEND_REQUEST_MESSAGE
  SYSTEM
  TRACE_LIKE
  TRACE_COMMENT
  COMMENT_REPLY
  TRACE_MENTION
  CIRCLE_VERIFICATION_REQUESTED
  CIRCLE_INVITATION_APPROVED
  CIRCLE_INVITATION_REJECTED
  CIRCLE_ADMIN_OVERRIDE_APPROVED
  CIRCLE_POST_PUBLISHED
  CIRCLE_POST_SIGNUP_CREATED
  CIRCLE_POST_AUTO_ENDED
  CIRCLE_POST_COLLABORATION_RECOGNIZED
  PROFILE_LIKE
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  CANCELED
  MISSED
  FAILED
}

enum CallParticipantStatus {
  INVITED
  JOINED
  LEFT
  REJECTED
  MISSED
}

enum CallEndReason {
  NORMAL
  CANCELED
  ALL_LEFT
  NO_ANSWER
  TIMEOUT
  NETWORK
  ERROR
}

enum MembershipBenefitType {
  STANDARD_FANCY_NUMBER
  PREMIUM_FANCY_NUMBER
}

enum FancyNumberStatus {
  AVAILABLE
  LEASED
  PERMANENT
  DISABLED
}

enum FancyNumberSource {
  ADMIN
  LEGACY
  CUSTOM
}

enum FancyNumberLeaseEndReason {
  EXPIRED
}

enum FancyNumberOrderType {
  PURCHASE
  RENEWAL
  SWITCH
  SUPER_CONVERSION
  LEGACY_GRANT
}

enum CircleAdminState {
  ACTIVE
  DISABLING
  DISABLED
  RESTORING
  SYNC_FAILED
  DISMISSED
}

enum AdminGroupOperationType {
  MUTE
  UNMUTE
  DISMISS
}

enum AdminGroupOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id                           String     @id @default(uuid())
  accountId                    String     @unique
  inviteCode                   String     @unique
  invitedByUserId              String?
  passwordHash                 String
  loginSecurityCodeHash        String?
  securityCodeAttempts         Int        @default(0)
  securityCodeLockedUntil      DateTime?
  // Admin console brute-force lockout (#83) — mirrors the security-code pair.
  adminLoginAttempts           Int        @default(0)
  adminLoginLockedUntil        DateTime?
  singleDeviceLoginEnabled     Boolean    @default(false)
  nickname                     String
  avatarUrl                    String?
  avatarFrame                  String?
  selectedAvatarFrameID        String?
  selectedAvatarFrameExpiresAt DateTime?
  cover                        String?
  email                        String?    @unique
  phoneNumber                  String?
  wechat                       String?
  qq                           String?
  whatsup                      String?
  persona                      String?
  helloWords                   String?
  birthday                     DateTime?
  city                         String?
  region                       String?
  gender                       Gender     @default(unset)
  role                         UserRole   @default(USER)
  status                       UserStatus @default(ACTIVE)
  vipLevel                     Int        @default(0)
  vipExpiresAt                 DateTime?
  creditScore                  Int        @default(100)
  fancyNumber                  Boolean    @default(false)
  fancyNumberExpiresAt         DateTime?
  fancyNumberPermanent         Boolean    @default(false)
  iconPreferencesInitialized   Boolean    @default(false)
  lastOnline                   DateTime?
  /// Set once the one-time friend-activity backfill has run for this user.
  activitiesBackfilledAt       DateTime?
  /// 收到的累计点赞总数（每人对其每天最多 +1），达阈值发放合作达人徽章。
  receivedLikeCount            Int        @default(0)
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  refreshTokens                     RefreshToken[]
  invitedBy                         User?                       @relation("UserInvitations", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitees                          User[]                      @relation("UserInvitations")
  referralsSent                     Referral[]                  @relation("ReferralInviter")
  referralReceived                 Referral?                   @relation("ReferralInvitee")
  friendsAsUser                     Friend[]                    @relation("userFriends")
  friendsAsFriend                   Friend[]                    @relation("userFriendsTo")
  blocksIssued                      Block[]                     @relation("blocker")
  blocksReceived                    Block[]                     @relation("blocked")
  notifications                     Notification[]              @relation("toUser")
  notificationsSent                 Notification[]              @relation("fromUser")
  devicePushTokens                  DevicePushToken[]
  traces                            Trace[]
  traceComments                     TraceComment[]
  traceLikeStats                    traceLikeStat[]
  likesGiven                        UserLike[]                  @relation("userLikesGiven")
  likesReceived                     UserLike[]                  @relation("userLikesReceived")
  tracePreferences                  UserTracePreference[]
  privacySetting                    UserPrivacySetting?
  wallet                            Wallet?
  coinTransactions                  CoinTransaction[]
  coinGiftsSent                     CoinGift[]                  @relation("giftSender")
  coinGiftsReceived                 CoinGift[]                  @relation("giftRecipient")
  collections                       UserCollection[]
  circlePostSignups                 CirclePostSignup[]
  friendTags                        FriendTag[]
  friendTagAssignments              FriendTagOnFriend[]         @relation("tagOwner")
  pendingFriendTagAssignments       PendingFriendTagOnRequest[] @relation("pendingTagOwner")
  friendActivities                  FriendActivity[]            @relation("friendActivityViewer")
  friendActivitiesAuthored          FriendActivity[]            @relation("friendActivityActor")
  friendActivitiesCounterparty      FriendActivity[]            @relation("friendActivityCounterparty")
  friendRequestMessages             FriendRequestMessage[]      @relation("friendRequestMessageSender")
  friendReportsFiled                FriendReport[]              @relation("friendReportReporter")
  friendReportsReceived             FriendReport[]              @relation("friendReportTarget")
  friendReportsReviewed             FriendReport[]              @relation("friendReportReviewer")
  groupReportsFiled                 GroupReport[]               @relation("groupReportReporter")
  creditEvents                      CreditEvent[]               @relation("creditEventUser")
  creditEventsAuthored              CreditEvent[]               @relation("creditEventActor")
  notes                             Note[]
  noteShareLinks                    NoteShareLink[]
  noteGroups                        NoteGroup[]
  circles                           Circle[]
  circleMembers                     CircleMember[]
  collaborationRecognitionsReceived CollaborationRecognition[]  @relation("collaborationRecognitionRecipient")
  collaborationRecognitionsGiven    CollaborationRecognition[]  @relation("collaborationRecognitionRecognizer")
  circlePosts                       CirclePost[]
  circleInvitationsAsApplicant      CircleInvitation[]          @relation("invitationApplicant")
  circleInvitationsAsInviter        CircleInvitation[]          @relation("invitationInviter")
  circleVerifications               CircleInvitationVerifier[]  @relation("verifierUser")
  circleVerificationsAdded          CircleInvitationVerifier[]  @relation("verifierAddedBy")
  iconAssetsCreated                 IconAsset[]                 @relation("iconAssetCreator")
  displayIcons                      UserDisplayIcon[]
  conversationGroups                ConversationGroup[]
  callSessionsInitiated             CallSession[]               @relation("callInitiator")
  callParticipants                  CallParticipant[]
  membershipGrantsReceived          MembershipGrant[]           @relation("membershipGrantTarget")
  membershipGrantsIssued            MembershipGrant[]           @relation("membershipGrantOperator")
  membershipBenefitGrants           MembershipBenefitGrant[]
  selectedAvatarFrame               AvatarFrameAsset?           @relation("selectedAvatarFrame", fields: [selectedAvatarFrameID], references: [id], onDelete: SetNull)
  avatarFrameGrants                 UserAvatarFrameGrant[]      @relation("avatarFrameGrantUser")
  avatarFrameGrantsIssued           UserAvatarFrameGrant[]      @relation("avatarFrameGrantOperator")
  avatarFrameGrantRevocations       UserAvatarFrameGrant[]      @relation("avatarFrameGrantRevoker")
  sessionRevocationOutbox           SessionRevocationOutbox?
  accountIdRegistry                 AccountIdentifier           @relation("userAccountIdRegistry", fields: [accountId], references: [value], onDelete: Restrict, onUpdate: Cascade, map: "User_accountId_registry_fkey")
  currentAccountIdentifier          AccountIdentifier?          @relation("currentAccountIdentifier")
  reservedAccountIdentifier         AccountIdentifier?          @relation("reservedAccountIdentifier")
  inviteAccountIdentifier           AccountIdentifier?          @relation("inviteAccountIdentifier")
  fancyNumbersCreated               FancyNumber[]               @relation("fancyNumberCreator")
  fancyNumberLeases                 FancyNumberLease[]
  fancyNumberOrders                 FancyNumberOrder[]
  groupExpansionOrders              GroupExpansionOrder[]
  supportAgentRoles                 SupportAgent[]

  @@index([invitedByUserId])
  @@index([selectedAvatarFrameID])
  @@index([createdAt])
  @@index([lastOnline])
  @@index([status, createdAt])
}

model AvatarFrameAsset {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String
  imageUrl        String?
  minimumVipLevel Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selectedByUsers User[]                 @relation("selectedAvatarFrame")
  grants          UserAvatarFrameGrant[]

  @@index([isActive, sortOrder, id])
}

model UserAvatarFrameGrant {
  id              String    @id @default(uuid())
  userID          String
  frameID         String
  operatorUserID  String
  idempotencyKey  String    @unique
  reason          String
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserID String?
  revokeReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User             @relation("avatarFrameGrantUser", fields: [userID], references: [id], onDelete: Restrict)
  frame         AvatarFrameAsset @relation(fields: [frameID], references: [id], onDelete: Restrict)
  operatorUser  User             @relation("avatarFrameGrantOperator", fields: [operatorUserID], references: [id], onDelete: Restrict)
  revokedByUser User?            @relation("avatarFrameGrantRevoker", fields: [revokedByUserID], references: [id], onDelete: Restrict)

  @@index([userID, revokedAt, expiresAt], map: "UserAvatarFrameGrant_user_active_idx")
  @@index([userID, createdAt, id], map: "UserAvatarFrameGrant_user_createdAt_id_idx")
  @@index([frameID, revokedAt, expiresAt], map: "UserAvatarFrameGrant_frame_active_idx")
  @@index([operatorUserID, createdAt])
  @@index([revokedByUserID, revokedAt])
}

model MembershipGrant {
  id                     String                  @id @default(uuid())
  idempotencyKey         String                  @unique
  targetUserID           String
  operatorUserID         String
  previousLevel          Int
  previousEffectiveLevel Int
  newLevel               Int
  previousExpiresAt      DateTime?
  newExpiresAt           DateTime?
  benefitTypesSnapshot   MembershipBenefitType[] @default([])
  note                   String?
  createdAt              DateTime                @default(now())

  targetUser    User                     @relation("membershipGrantTarget", fields: [targetUserID], references: [id], onDelete: Restrict)
  operatorUser  User                     @relation("membershipGrantOperator", fields: [operatorUserID], references: [id], onDelete: Restrict)
  benefitGrants MembershipBenefitGrant[]

  @@index([targetUserID, createdAt])
  @@index([operatorUserID, createdAt])
  @@index([createdAt])
}

model MembershipProgramState {
  id              Int       @id
  enabledAt       DateTime?
  enabledByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

/// 客服账号。原本是 App 的编译期常量（EXPO_PUBLIC_SUPPORT_*），换客服要重新出包发版；
/// 改为服务端存储 + 管理台维护 + App 运行时拉取。用行而不是逗号分隔字符串：
/// 「一类多客服」是既有需求，行结构还能排序和单独停用。
model SupportAgent {
  id        String               @id @default(uuid())
  category  SupportAgentCategory
  userID    String
  sortOrder Int                  @default(0)
  /// 停用而不删除：保留配置痕迹，避免「删了又加回来」丢失顺序。
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  /// 同一类里不允许重复挂同一个人。
  @@unique([category, userID])
  @@index([category, enabled, sortOrder])
}

model MembershipBenefitGrant {
  id                String                @id @default(uuid())
  userID            String
  membershipGrantID String
  type              MembershipBenefitType
  createdAt         DateTime              @default(now())

  user            User            @relation(fields: [userID], references: [id], onDelete: Restrict)
  membershipGrant MembershipGrant @relation(fields: [membershipGrantID], references: [id], onDelete: Restrict)

  @@unique([userID, type])
  @@index([membershipGrantID])
}

model AccountIdentifier {
  value             String   @id
  currentUserID     String?  @unique
  reservedForUserID String?  @unique
  inviteOwnerUserID String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  currentUser User?        @relation("currentAccountIdentifier", fields: [currentUserID], references: [id], onDelete: Restrict)
  reservedFor User?        @relation("reservedAccountIdentifier", fields: [reservedForUserID], references: [id], onDelete: Restrict)
  inviteOwner User?        @relation("inviteAccountIdentifier", fields: [inviteOwnerUserID], references: [id], onDelete: Restrict)
  accountUser User?        @relation("userAccountIdRegistry")
  fancyNumber FancyNumber?
}

model FancyNumber {
  id              String            @id @default(uuid())
  value           String            @unique
  status          FancyNumberStatus @default(AVAILABLE)
  source          FancyNumberSource @default(ADMIN)
  isRecommended   Boolean           @default(false)
  sortOrder       Int               @default(0)
  createdByUserID String?
  disabledAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  identifier AccountIdentifier  @relation(fields: [value], references: [value], onDelete: Restrict, onUpdate: Cascade)
  createdBy  User?              @relation("fancyNumberCreator", fields: [createdByUserID], references: [id], onDelete: SetNull)
  leases     FancyNumberLease[]
  orders     FancyNumberOrder[]

  @@index([status, sortOrder, id])
  @@index([isRecommended, status, sortOrder, id], map: "FancyNumber_recommended_status_sort_idx")
}

model FancyNumberLease {
  id               String                     @id @default(uuid())
  userID           String
  fancyNumberID    String
  restoreAccountId String?
  startedAt        DateTime                   @default(now())
  expiresAt        DateTime?
  permanentAt      DateTime?
  endedAt          DateTime?
  endReason        FancyNumberLeaseEndReason?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  user        User               @relation(fields: [userID], references: [id], onDelete: Restrict)
  fancyNumber FancyNumber        @relation(fields: [fancyNumberID], references: [id], onDelete: Restrict)
  orders      FancyNumberOrder[]

  @@index([userID, createdAt])
  @@index([fancyNumberID, createdAt])
  @@index([endedAt, expiresAt])
}

model FancyNumberOrder {
  id                 String               @id @default(uuid())
  idempotencyKey     String               @unique
  requestFingerprint String
  type               FancyNumberOrderType
  userID             String
  fancyNumberID      String
  leaseID            String
  months             Int?
  unitPrice          Int
  totalPrice         Int
  walletBalanceAfter Int?
  previousExpiresAt  DateTime?
  newExpiresAt       DateTime?
  createdAt          DateTime             @default(now())

  user        User             @relation(fields: [userID], references: [id], onDelete: Restrict)
  fancyNumber FancyNumber      @relation(fields: [fancyNumberID], references: [id], onDelete: Restrict)
  lease       FancyNumberLease @relation(fields: [leaseID], references: [id], onDelete: Restrict)

  @@index([userID, createdAt])
  @@index([fancyNumberID, createdAt])
  @@index([leaseID, createdAt])
  @@index([createdAt])
}

model SessionRevocationOutbox {
  userID        String   @id
  revokedAt     DateTime
  expiresAt     DateTime
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
  @@index([expiresAt])
}

model RefreshToken {
  id               String                        @id @default(uuid())
  userId           String
  token            String                        @unique
  familyId         String                        @default(dbgenerated("(gen_random_uuid())::text"))
  audience         RefreshTokenAudience          @default(APP)
  deviceName       String?
  ip               String?
  userAgent        String?
  expiredAt        DateTime
  revokedAt        DateTime?
  revocationReason RefreshTokenRevocationReason?
  createdAt        DateTime                      @default(now())
  lastUsedAt       DateTime                      @default(now())
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, familyId])
  @@index([userId, audience, createdAt])
}

// ─── Social ───────────────────────────────────────────────────────────────────

model Friend {
  id                         String                      @id @default(uuid())
  userID                     String
  friendID                   String
  state                      FriendState                 @default(PENDING)
  message                    String?
  pendingRemarkBySender      String?
  /// userID's private remark for friendID
  remarkA                    String?
  /// friendID's private remark for userID
  remarkB                    String?
  /// Sender-owned private description staged on the request, promoted on accept
  pendingDescriptionBySender String?
  /// userID's private description note for friendID
  descriptionA               String?
  /// friendID's private description note for userID
  descriptionB               String?
  /// Sender-owned description photo keys staged on the request, promoted on accept
  pendingPhotosBySender      String[]                    @default([])
  /// userID's private description photo keys for friendID
  photosA                    String[]                    @default([])
  /// friendID's private description photo keys for userID
  photosB                    String[]                    @default([])
  /// Permission the sender grants the target, staged on the request
  pendingPermissionBySender  FriendPermission?
  /// userID's granted permission for friendID (gates friendID seeing userID's moments)
  permissionA                FriendPermission            @default(FULL)
  /// friendID's granted permission for userID (gates userID seeing friendID's moments)
  permissionB                FriendPermission            @default(FULL)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  user                       User                        @relation("userFriends", fields: [userID], references: [id], onDelete: Cascade)
  friend                     User                        @relation("userFriendsTo", fields: [friendID], references: [id], onDelete: Cascade)
  tagLinks                   FriendTagOnFriend[]
  pendingTagLinks            PendingFriendTagOnRequest[]
  activities                 FriendActivity[]
  messages                   FriendRequestMessage[]
  chatReplayJobs             FriendChatReplayOutbox[]
  requestNotifications       Notification[]              @relation("friendRequestNotifications")

  @@index([userID])
  @@index([friendID])
}

// 好友申请阶段的多轮留言线程（双方 accept/reject 前的往来）。
// 接受后按序注入两人 OpenIM 会话成为聊天首屏历史。
model FriendRequestMessage {
  id        String   @id @default(uuid())
  requestId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  request Friend @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User   @relation("friendRequestMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model FriendChatReplayOutbox {
  id              String                 @id @default(uuid())
  requestId       String                 @unique
  requesterUserID String
  accepterUserID  String
  status          FriendChatReplayStatus @default(PENDING)
  leaseToken      String?
  stage           Int                    @default(0)
  messageIndex    Int                    @default(0)
  attempts        Int                    @default(0)
  lastError       String?
  nextAttemptAt   DateTime               @default(now())
  lockedAt        DateTime?
  processedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  request Friend @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

enum FriendReportStatus {
  PENDING
  APPROVED
  REJECTED
}

/// #92：群/圈子帖子报告的三态审核（与 FriendReportStatus 同值集，独立命名
/// 避免「好友报告」语义扩散）。
enum ReportReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model FriendReport {
  id           String             @id @default(uuid())
  reporterID   String
  targetID     String
  category     String
  description  String
  evidence     String[]           @default([])
  status       FriendReportStatus @default(PENDING)
  reviewedByID String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  reporter   User  @relation("friendReportReporter", fields: [reporterID], references: [id], onDelete: Cascade)
  target     User  @relation("friendReportTarget", fields: [targetID], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("friendReportReviewer", fields: [reviewedByID], references: [id], onDelete: SetNull)

  // Uniqueness is enforced by a partial index (see migration
  // add_friend_report_reportable_after_rejection): at most one non-REJECTED
  // report per (reporter, target, category), so a rejected report frees the
  // slot for a fresh one. Prisma can't express a partial @@unique, so it lives
  // in raw SQL and is intentionally absent here.
  @@index([reporterID, createdAt])
  @@index([targetID, createdAt])
  @@index([status, createdAt])
}

model GroupReport {
  id           String             @id @default(uuid())
  reporterID   String
  groupID      String
  circleID     String?
  category     String
  description  String
  evidence     String[]           @default([])
  status       ReportReviewStatus @default(PENDING)
  reviewedByID String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  reporter User    @relation("groupReportReporter", fields: [reporterID], references: [id], onDelete: Cascade)
  circle   Circle? @relation("groupReports", fields: [circleID], references: [id], onDelete: SetNull)

  // review 修复：唯一约束收窄到 PENDING（局部唯一索引，见
  // 20260721160000_report_reopen_partial_unique）。硬唯一会让「审结后再次
  // 举报」永远建不出新 PENDING 行 —— 复发的违规无法再进审核队列。
  @@index([reporterID, groupID, category])
  @@index([reporterID, createdAt])
  @@index([groupID, createdAt])
  @@index([status, createdAt])
  @@index([circleID, createdAt])
}

model CreditEvent {
  id             String   @id @default(uuid())
  userID         String
  delta          Int
  scoreBefore    Int
  scoreAfter     Int
  reason         String
  sourceType     String
  sourceID       String?
  actorID        String?
  idempotencyKey String?  @unique
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User  @relation("creditEventUser", fields: [userID], references: [id], onDelete: Cascade)
  actor User? @relation("creditEventActor", fields: [actorID], references: [id], onDelete: SetNull)

  @@index([userID, createdAt])
  @@index([actorID, createdAt])
  @@index([sourceType, sourceID])
}

model Note {
  id                  String     @id @default(uuid())
  ownerID             String
  groupID             String?
  title               String
  content             String?
  contentJson         Json?
  sections            Json?
  status              NoteStatus @default(ACTIVE)
  available           Boolean    @default(true)
  pinned              Boolean    @default(false)
  coverMediaID        String?    @unique
  mediaCount          Int        @default(0)
  imageCount          Int        @default(0)
  videoCount          Int        @default(0)
  // 仅笔记主人可见的私人备注 —— 不随分享/访客视图外发（序列化时按 viewer 判空）。
  remark              String?
  // 从聊天收藏他人笔记时的来源快照（会话类型、群/发送者名片、消息定位信息）。
  // 自建笔记为 null；collectedFromNoteID 冗余成单列用于幂等去重查询。
  collectedFrom       Json?
  collectedFromNoteID String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  owner            User                  @relation(fields: [ownerID], references: [id], onDelete: Cascade)
  group            NoteGroup?            @relation(fields: [groupID], references: [id], onDelete: SetNull)
  media            NoteMedia[]           @relation("noteMediaItems")
  coverMedia       NoteMedia?            @relation("noteCoverMedia", fields: [coverMediaID], references: [id], onDelete: SetNull)
  groupMemberships NoteGroupMembership[]
  // Active collect idempotency is enforced by a raw partial unique index in
  // migration 20260702010000_add_note_collected_from. Prisma cannot model the
  // `WHERE collectedFromNoteID IS NOT NULL AND status <> 'DELETED'` predicate.

  @@index([ownerID, status, updatedAt])
  @@index([ownerID, pinned, updatedAt])
  @@index([groupID])
}

model NoteShareLink {
  id        String      @id @default(uuid())
  ownerID   String
  token     String      @unique
  title     String
  status    NoteStatus?
  group     String?
  groupID   String?
  search    String?
  noteIDs   String[]    @default([])
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner User @relation(fields: [ownerID], references: [id], onDelete: Cascade)

  @@index([ownerID, createdAt])
  @@index([token])
  @@index([expiresAt])
}

model NoteMedia {
  id         String        @id @default(uuid())
  noteID     String
  type       NoteMediaType
  objectKey  String
  url        String
  mimeType   String?
  size       Int?
  width      Int?
  height     Int?
  durationMs Int?
  posterUrl  String?
  sortOrder  Int
  createdAt  DateTime      @default(now())

  note         Note  @relation("noteMediaItems", fields: [noteID], references: [id], onDelete: Cascade)
  coverForNote Note? @relation("noteCoverMedia")

  @@unique([noteID, sortOrder])
  @@index([noteID, sortOrder])
}

model NoteGroup {
  id        String    @id @default(uuid())
  ownerID   String
  name      String
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner       User                  @relation(fields: [ownerID], references: [id], onDelete: Cascade)
  notes       Note[]
  memberships NoteGroupMembership[]

  @@index([ownerID, deletedAt, sortOrder])
}

model NoteGroupMembership {
  id        String   @id @default(uuid())
  noteID    String
  groupID   String
  createdAt DateTime @default(now())

  note  Note      @relation(fields: [noteID], references: [id], onDelete: Cascade)
  group NoteGroup @relation(fields: [groupID], references: [id], onDelete: Cascade)

  @@unique([noteID, groupID])
  @@index([groupID])
}

model FriendActivity {
  id              String             @id @default(uuid())
  requestId       String
  viewerId        String
  actorId         String
  counterpartyId  String
  type            FriendActivityType
  messageSnapshot String?
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  request         Friend             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  viewer          User               @relation("friendActivityViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  actor           User               @relation("friendActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  counterparty    User               @relation("friendActivityCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([requestId, viewerId, type])
  // review 修复：保留期清理按裸 createdAt 截断分批删除
  @@index([createdAt])
  @@index([requestId])
  @@index([viewerId, createdAt])
  @@index([viewerId, readAt])
}

// Friend tags — user-defined labels like "高中同学", "同事"
model FriendTag {
  id              String                      @id @default(uuid())
  ownerID         String
  name            String
  color           String?
  createdAt       DateTime                    @default(now())
  owner           User                        @relation(fields: [ownerID], references: [id], onDelete: Cascade)
  friends         FriendTagOnFriend[]
  pendingRequests PendingFriendTagOnRequest[]

  @@unique([ownerID, name])
  @@index([ownerID])
}

// Junction: which tags an owner has applied to which friendship
model FriendTagOnFriend {
  id         String    @id @default(uuid())
  ownerID    String
  tagID      String
  friendID   String // the Friend record id
  createdAt  DateTime  @default(now())
  owner      User      @relation("tagOwner", fields: [ownerID], references: [id], onDelete: Cascade)
  tag        FriendTag @relation(fields: [tagID], references: [id], onDelete: Cascade)
  friendship Friend    @relation(fields: [friendID], references: [id], onDelete: Cascade)

  @@unique([ownerID, tagID, friendID])
  @@index([ownerID, friendID])
}

model PendingFriendTagOnRequest {
  id        String    @id @default(uuid())
  ownerID   String
  requestID String
  tagID     String
  createdAt DateTime  @default(now())
  owner     User      @relation("pendingTagOwner", fields: [ownerID], references: [id], onDelete: Cascade)
  request   Friend    @relation(fields: [requestID], references: [id], onDelete: Cascade)
  tag       FriendTag @relation(fields: [tagID], references: [id], onDelete: Cascade)

  @@unique([ownerID, requestID, tagID])
  @@index([ownerID, requestID])
  @@index([requestID])
}

model Block {
  id        String   @id @default(uuid())
  blockerID String
  blockedID String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerID], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedID], references: [id], onDelete: Cascade)

  @@unique([blockerID, blockedID])
  @@index([blockerID])
  @@index([blockedID])
}

model CallSession {
  id              String         @id @default(uuid())
  conversationID  String
  sessionType     Int
  callType        CallType
  status          CallStatus     @default(RINGING)
  livekitRoomName String         @unique
  initiatorID     String
  startedAt       DateTime?
  endedAt         DateTime?
  expiresAt       DateTime
  endedByID       String?
  endReason       CallEndReason?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  initiator    User              @relation("callInitiator", fields: [initiatorID], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([conversationID, createdAt])
  @@index([initiatorID, status])
  @@index([expiresAt, status])
}

model CallParticipant {
  id          String                @id @default(uuid())
  callID      String
  userID      String
  status      CallParticipantStatus @default(INVITED)
  invitedAt   DateTime              @default(now())
  joinedAt    DateTime?
  leftAt      DateTime?
  rejectedAt  DateTime?
  missedAt    DateTime?
  lastTokenAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  call CallSession @relation(fields: [callID], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([callID, userID])
  @@index([userID, status])
  @@index([callID, status])
}

// ─── Conversation Group ───────────────────────────────────────────────────────
//
// User-defined buckets for organizing chat conversations (private + group).
// Per-user, no sharing across accounts.
//   - pinnedToTabs: whether this bucket renders as a filter tab on the messages list.
//   - sortOrder: reserved for v2 drag-reorder; v1 reads by createdAt.
//
// Membership is plain `conversationID` (OpenIM string id) — we don't FK to any
// conversation table because conversations live in OpenIM, not Postgres.

model ConversationGroup {
  id           String                        @id @default(uuid())
  ownerID      String
  name         String
  sortOrder    Int                           @default(0)
  pinnedToTabs Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  owner        User                          @relation(fields: [ownerID], references: [id], onDelete: Cascade)
  memberships  ConversationGroupMembership[]

  @@unique([ownerID, name])
  @@index([ownerID])
}

model ConversationGroupMembership {
  groupID        String
  conversationID String
  createdAt      DateTime          @default(now())
  group          ConversationGroup @relation(fields: [groupID], references: [id], onDelete: Cascade)

  @@id([groupID, conversationID])
  @@index([conversationID])
}

// ─── Trace ────────────────────────────────────────────────────────────────────

model Trace {
  id         String          @id @default(uuid())
  title      String          @default("")
  content    String          @default("")
  deleted    Boolean         @default(false)
  visibility TraceVisibility @default(PUBLIC)
  images     String[]        @default([])
  type       TraceType
  fromID     String
  likeCount  Int             @default(0)
  replyCount Int             @default(0)
  shareCount Int             @default(0)
  viewCount  Int             @default(0)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  from          User                  @relation(fields: [fromID], references: [id], onDelete: Cascade)
  comments      TraceComment[]
  likeStats     traceLikeStat[]
  preferences   UserTracePreference[]
  notifications Notification[]

  // Feed keyset pagination orders by (createdAt DESC, id DESC) filtered by
  // fromID. Including the id tiebreaker keeps the index aligned with the cursor
  // ordering and still covers plain fromID lookups.
  @@index([fromID, createdAt(sort: Desc), id(sort: Desc)])
}

model TraceComment {
  id        String   @id @default(uuid())
  content   String   @default("")
  images    String[] @default([])
  deleted   Boolean  @default(false)
  private   Boolean  @default(false)
  traceID   String
  userID    String
  replyToID String?
  parentID  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trace    Trace          @relation(fields: [traceID], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userID], references: [id], onDelete: Cascade)
  parent   TraceComment?  @relation("CommentParent", fields: [parentID], references: [id])
  children TraceComment[] @relation("CommentParent")
  replyTo  TraceComment?  @relation("CommentReply", fields: [replyToID], references: [id])
  replies  TraceComment[] @relation("CommentReply")

  fromNotifications Notification[] @relation("fromReply")
  toNotifications   Notification[] @relation("toReply")

  @@index([traceID])
  @@index([userID])
}

model traceLikeStat {
  id        String   @id @default(uuid())
  traceID   String
  userID    String
  deleted   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  trace     Trace    @relation(fields: [traceID], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([traceID, userID])
}

model UserTracePreference {
  id        String                  @id @default(uuid())
  userID    String
  traceID   String
  type      UserTracePreferenceType
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  trace     Trace                   @relation(fields: [traceID], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([userID, traceID])
  @@index([userID])
  @@index([traceID])
}

model UserPrivacySetting {
  id                      String   @id @default(uuid())
  userID                  String   @unique
  /// 0 = 关闭自动销毁。与 DEFAULT_PRIVACY_SETTINGS 保持一致。
  messageSelfDestructDays Int      @default(0)
  momentsVisibility       String   @default("ALL")
  allowStrangerMessages   Boolean  @default(true)
  showPhone               Boolean  @default(false)
  showWechat              Boolean  @default(true)
  showQQ                  Boolean  @default(true)
  showWhatsup             Boolean  @default(true)
  addMeByAccount          Boolean  @default(true)
  addMeByPhone            Boolean  @default(false)
  addMeByQrCode           Boolean  @default(true)
  addMeByGroup            Boolean  @default(true)
  callPermission          String   @default("EVERYONE")
  groupInvitePermission   String   @default("EVERYONE")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
}

// ─── Coin / Wallet ────────────────────────────────────────────────────────────

enum ReferralStatus {
  PENDING
  REWARDED
  CAPPED
  REJECTED
  EXPIRED
}

enum CoinTxType {
  RECHARGE // top-up by admin / payment
  GIFT_SENT // deducted when sending a gift
  GIFT_RECEIVED // credited when receiving a gift
  REFUND // admin refund
  PURCHASE // deducted when buying membership or mall items
  ADJUSTMENT // manual admin correction
  REFERRAL_REWARD // credited to the inviter after a referral qualifies
  REFERRAL_BONUS // credited to the qualified invitee
}

enum CollectionType {
  CHAT
  VIDEO
  VOICE
  MESSAGE
  NOTE
}

model Wallet {
  id        String   @id @default(uuid())
  userID    String   @unique
  balance   Int      @default(0) // stored in smallest unit (1 coin = 1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userID], references: [id], onDelete: Cascade)
}

model CoinTransaction {
  id             String     @id @default(uuid())
  userID         String
  type           CoinTxType
  amount         Int // positive = credit, negative = debit
  balance        Int // balance after this tx
  note           String?
  relatedID      String? // e.g. CoinGift.id for gift txs
  /// #91：会员兑换等入口的 Idempotency-Key（可空唯一）。
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID, createdAt])
  @@index([type, createdAt])
}

model Referral {
  id            String         @id @default(uuid())
  inviterID     String
  inviteeID     String         @unique
  status        ReferralStatus @default(PENDING)
  inviterReward Int
  inviteeReward Int
  eligibleAt    DateTime
  nextCheckAt   DateTime
  expiresAt     DateTime
  qualifiedAt   DateTime?
  rewardedAt    DateTime?
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inviter       User           @relation("ReferralInviter", fields: [inviterID], references: [id], onDelete: Cascade)
  invitee       User           @relation("ReferralInvitee", fields: [inviteeID], references: [id], onDelete: Cascade)

  @@index([status, nextCheckAt])
  @@index([inviterID, rewardedAt])
  @@index([inviterID, createdAt])
}

model CoinGift {
  id              String    @id @default(uuid())
  senderID        String
  recipientID     String
  amount          Int
  message         String?
  /// Client-supplied Idempotency-Key — a retry of the same gift reuses it
  /// and is rejected by the unique constraint instead of double-charging.
  idempotencyKey  String?   @unique
  /// #100：转账卡片补偿。客户端 IM 发卡成功后回执置位；超时未置位由
  /// 服务端补发（gift-card outbox cron），钱与卡从「两个不相关操作」
  /// 变成「最终必达」。
  cardDeliveredAt DateTime?
  cardAttempts    Int       @default(0)
  createdAt       DateTime  @default(now())
  sender          User      @relation("giftSender", fields: [senderID], references: [id], onDelete: Cascade)
  recipient       User      @relation("giftRecipient", fields: [recipientID], references: [id], onDelete: Cascade)
  // round 2：待补卡片的局部索引（WHERE cardDeliveredAt IS NULL）在迁移
  // 20260721180000 里用原生 SQL 建 —— Prisma schema 无法表达 partial index。

  @@index([senderID])
  @@index([recipientID])
}

model UserCollection {
  id        String         @id @default(uuid())
  userID    String
  type      CollectionType
  title     String
  summary   String?
  sourceID  String?
  payload   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID, type, createdAt])
}

model IconAsset {
  id          String              @id @default(uuid())
  name        String
  sourceType  IconAssetSourceType
  imageUrl    String?
  circleID    String?
  createdByID String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  circle            Circle?  @relation("circleIconAssets", fields: [circleID], references: [id], onDelete: Cascade)
  createdBy         User?    @relation("iconAssetCreator", fields: [createdByID], references: [id], onDelete: SetNull)
  currentForCircles Circle[] @relation("currentCircleIcon")

  @@index([circleID])
  @@index([sourceType])
}

model UserDisplayIcon {
  id            String              @id @default(uuid())
  userID        String
  displayType   UserDisplayIconType
  systemKey     SystemIconKey?
  systemVariant String?
  circleID      String?
  sortOrder     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user   User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  circle Circle? @relation(fields: [circleID], references: [id], onDelete: Cascade)

  @@unique([userID, systemKey, systemVariant])
  @@unique([userID, circleID])
  @@index([userID, sortOrder])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id                   String           @id @default(uuid())
  content              String           @default("")
  deleted              Boolean          @default(false)
  read                 Boolean          @default(false)
  type                 NotificationType
  toUserID             String?
  fromUserID           String
  fromTraceID          String?
  fromReplyID          String?
  toReplyID            String?
  fromCircleID         String?
  fromCirclePostID     String?
  fromInvitationID     String?
  fromFriendRequestID  String?
  systemAnnouncementID String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  toUser             User?                   @relation("toUser", fields: [toUserID], references: [id])
  fromUser           User                    @relation("fromUser", fields: [fromUserID], references: [id])
  fromTrace          Trace?                  @relation(fields: [fromTraceID], references: [id])
  fromReply          TraceComment?           @relation("fromReply", fields: [fromReplyID], references: [id])
  toReply            TraceComment?           @relation("toReply", fields: [toReplyID], references: [id])
  fromCircle         Circle?                 @relation(fields: [fromCircleID], references: [id])
  fromCirclePost     CirclePost?             @relation(fields: [fromCirclePostID], references: [id])
  fromInvitation     CircleInvitation?       @relation(fields: [fromInvitationID], references: [id])
  fromFriendRequest  Friend?                 @relation("friendRequestNotifications", fields: [fromFriendRequestID], references: [id])
  systemAnnouncement SystemAnnouncement?     @relation(fields: [systemAnnouncementID], references: [id], onDelete: Restrict)
  pushOutbox         NotificationPushOutbox?

  @@unique([systemAnnouncementID, toUserID], map: "Notification_announcement_recipient_key")
  @@index([fromUserID, toUserID])
  @@index([toUserID])
  // review 修复：保留期清理按裸 createdAt 截断分批删除
  @@index([createdAt])
  @@index([fromFriendRequestID])
}

model SystemAnnouncement {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  requestFingerprint String
  operatorID         String
  content            String
  createdAt          DateTime @default(now())
  auditRecordedAt    DateTime?
  fanoutCompletedAt  DateTime?
  recipientCount     Int?

  notifications Notification[]

  @@index([createdAt])
}

model NotificationPushOutbox {
  id             String                       @id @default(uuid())
  notificationID String                       @unique
  status         NotificationPushOutboxStatus @default(PENDING)
  leaseToken     String?
  attempts       Int                          @default(0)
  lastError      String?
  nextAttemptAt  DateTime                     @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  /// Immutable snapshot of the composed push payload (#88) — retries resend
  /// exactly what was originally composed instead of re-reading live rows.
  payload        Json?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  notification Notification               @relation(fields: [notificationID], references: [id], onDelete: Cascade)
  deliveries   NotificationPushDelivery[]

  @@index([status, nextAttemptAt])
}

model NotificationPushDelivery {
  id               String                         @id @default(uuid())
  outboxID         String
  notificationID   String
  /// Raw Expo token snapshot — reaping via receipts works even after the
  /// DevicePushToken row rotates or is pruned.
  token            String
  ticketID         String?
  status           NotificationPushDeliveryStatus @default(PENDING)
  lastError        String?
  attempts         Int                            @default(0)
  sentAt           DateTime?
  receiptCheckedAt DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  outbox NotificationPushOutbox @relation(fields: [outboxID], references: [id], onDelete: Cascade)

  @@unique([notificationID, token])
  @@index([status, sentAt])
  // round 2：sweep 按 outboxID+status+attempts 查询/计数（外键不自动建索引）
  @@index([outboxID, status, attempts])
}

/// #90：管理台操作审计。业务日志有 actor/target 但缺 ip/UA 与结构化前后值；
/// 事后取证需要「谁、从哪、把什么从 A 改成了 B」。只追加不更新。
/// 管理台唯一的审计流水：治理侧（#90 下架/恢复）和用户中心（#121 封禁/解封/
/// 敏感字段查看）都写这里。审计要的是「某管理员做过什么」的全量视图，拆成两张
/// 表会让任何跨模块追溯都退化成 UNION。
model AdminAuditLog {
  id             String   @id @default(uuid())
  actorID        String
  /// 用户中心的列表要展示操作者账号；治理侧只记 actorID，故可空。
  actorAccountId String?
  action         String
  entityType     String?
  entityID       String?
  before         Json?
  after          Json?
  reason         String?
  metadata       Json?
  requestId      String?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([actorID, createdAt])
  @@index([entityType, entityID, createdAt])
  @@index([action, createdAt])
}

model DevicePushToken {
  id                   String    @id @default(uuid())
  token                String    @unique
  provider             String
  platform             String
  projectId            String?
  appVersion           String?
  revocationSecretHash String?
  disabledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userID String
  user   User   @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@index([provider, platform])
}

// ─── Circle Plaza ────────────────────────────────────────────────────────────

model Circle {
  id                    String           @id @default(uuid())
  name                  String
  description           String           @default("")
  avatarUrl             String?
  cover                 String?
  ownerID               String
  currentIconAssetID    String?
  cities                String[]         @default([])
  isPublic              Boolean          @default(false)
  categories            String[]         @default([])
  rules                 String           @default("")
  tags                  String[]         @default([])
  joinVipRestriction    Int?
  joinCreditRestriction Int?
  joinFancyRestriction  Boolean          @default(false)
  maxMembers            Int?
  expansionSeats        Int              @default(0)
  memberCanPost         Boolean          @default(true)
  /// 建担保单时快照进 CircleInvitation.requiredCount。宣传期默认 1:成员邀请自动
  /// 带首票,建单即满 → 立即入圈;后期收紧改成 10 恢复满员担保。改值不影响在途申请。
  requiredVerifierCount Int              @default(1)
  /// false = 普通成员的邀请入口关闭,只留 OWNER/ADMIN(「只有管理员拉人」的严格形态)。
  memberCanInvite       Boolean          @default(true)
  groupID               String?          @unique
  memberCount           Int              @default(0)
  postCount             Int              @default(0)
  deleted               Boolean          @default(false)
  adminState            CircleAdminState @default(ACTIVE)
  adminDisabledAt       DateTime?
  adminDisabledBy       String?
  adminDisableReason    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  owner             User                  @relation(fields: [ownerID], references: [id], onDelete: Cascade)
  currentIconAsset  IconAsset?            @relation("currentCircleIcon", fields: [currentIconAssetID], references: [id], onDelete: SetNull)
  iconAssets        IconAsset[]           @relation("circleIconAssets")
  posts             CirclePost[]
  postLinks         CirclePostCircle[]
  members           CircleMember[]
  invitations       CircleInvitation[]
  notifications     Notification[]
  displaySelections UserDisplayIcon[]
  groupReports      GroupReport[]         @relation("groupReports")
  expansionOrders   GroupExpansionOrder[]

  @@index([ownerID])
  @@index([adminState, createdAt])
  @@index([deleted, createdAt])
  /// GET /circle?city= 走 `cities has ?`（= cities @> ARRAY[?]），数组包含查询用不了
  /// btree。没有这个 GIN 索引时每次请求都是一次全表顺序扫描 + 一次排序，而且
  /// service 里 findMany 与 count 是 Promise.all 并发发出的 —— 一个请求同时占用两个
  /// 连接（池只有 10 个）。GET 上又没有路由级限流，只有 300 次/分钟/IP 的兜底，
  /// 这是纯读接口里最容易被一个脚本打爆的一条。CirclePost.cities 早就有同款索引。
  @@index([cities], type: Gin)
}

model AdminGroupOperation {
  id             String                    @id @default(uuid())
  idempotencyKey String                    @unique
  groupID        String
  circleID       String?
  type           AdminGroupOperationType
  status         AdminGroupOperationStatus @default(PENDING)
  requestedByID  String
  reason         String
  attempts       Int                       @default(0)
  maxAttempts    Int                       @default(5)
  nextAttemptAt  DateTime                  @default(now())
  claimedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([groupID, createdAt])
  @@index([circleID, createdAt])
}

model GroupExpansionOrder {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  requestFingerprint String
  userID             String
  circleID           String
  productID          String
  productName        String
  seats              Int
  price              Int
  previousMaxMembers Int
  newMaxMembers      Int
  walletBalanceAfter Int
  createdAt          DateTime @default(now())

  user   User   @relation(fields: [userID], references: [id], onDelete: Restrict)
  circle Circle @relation(fields: [circleID], references: [id], onDelete: Restrict)

  @@index([userID, createdAt])
  @@index([circleID, createdAt])
  @@index([createdAt])
}

model CircleMember {
  id        String             @id @default(uuid())
  userID    String
  circleID  String
  role      CircleMemberRole   @default(MEMBER)
  status    CircleMemberStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User   @relation(fields: [userID], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleID], references: [id], onDelete: Cascade)

  @@unique([userID, circleID])
  @@index([circleID])
  @@index([status, createdAt])
}

model CirclePost {
  id                        String           @id @default(uuid())
  content                   String           @default("")
  images                    String[]         @default([])
  tags                      String[]         @default([])
  // `city` 保留为「主城市」(= cities[0]) 兼容旧数据/旧客户端；`cities` 是多选来源。
  city                      String?
  cities                    String[]         @default([])
  isHorn                    Boolean          @default(false)
  noteID                    String?
  vipRestriction            Int?
  creditRestriction         Int?
  fancyRestriction          Boolean          @default(false)
  viewCount                 Int              @default(0)
  signupCount               Int              @default(0)
  signupVipRestriction      Int?
  signupCreditRestriction   Int?
  signupFancyRestriction    Boolean          @default(false)
  status                    CirclePostStatus @default(ACTIVE)
  endedAt                   DateTime?
  collaborationRecognizedAt DateTime?
  expiresAt                 DateTime?
  authorID                  String
  circleID                  String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  author                    User                       @relation(fields: [authorID], references: [id], onDelete: Cascade)
  // `circle`/`circleID` 保留为「主圈子」(= circleIds[0])，兼容旧查询/计数；
  // `circleLinks` 是多选真源（含主圈子），feed 可见性/筛选走它。
  circle                    Circle                     @relation(fields: [circleID], references: [id], onDelete: Cascade)
  circleLinks               CirclePostCircle[]
  signups                   CirclePostSignup[]
  collaborationRecognitions CollaborationRecognition[]
  notifications             Notification[]

  @@index([circleID, createdAt(sort: Desc)])
  @@index([authorID])
  @@index([city, createdAt(sort: Desc)])
  @@index([cities], type: Gin)
  @@index([status, expiresAt])
  // Plaza feed keyset: status='ACTIVE' equality + ORDER BY (createdAt DESC, id
  // DESC) is served as a pure index scan (no heapsort). Status-aware, so it
  // stays efficient as ENDED/DELETED posts accumulate. Verified ~135x faster
  // than the heapsort baseline on a 40k-post / 50-circle EXPLAIN ANALYZE.
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
}

// 一条动态 ↔ 多个圈子的关联表（含主圈子）。一条动态可同时出现在多个圈子的广场。
model CirclePostCircle {
  id        String   @id @default(uuid())
  postID    String
  circleID  String
  createdAt DateTime @default(now())

  post   CirclePost @relation(fields: [postID], references: [id], onDelete: Cascade)
  circle Circle     @relation(fields: [circleID], references: [id], onDelete: Cascade)

  @@unique([postID, circleID])
  // 按圈子拉取广场 feed 的主查询路径（circleID → 该圈子的所有动态）。
  @@index([circleID, postID])
}

model CirclePostSignup {
  id           String    @id @default(uuid())
  postID       String
  userID       String
  seenByAuthor Boolean   @default(false)
  seenAt       DateTime?
  createdAt    DateTime  @default(now())

  post CirclePost @relation(fields: [postID], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([postID, userID])
  @@index([postID])
  @@index([userID])
  @@index([postID, seenByAuthor])
}

// 圈子帖子举报（内容举报日志）。独立表、不建外键关系：举报是审计日志，帖子删除后
// 保留孤儿记录也无妨，从而无需改动庞大的 CirclePost / User 模型。同一用户对同一帖
// 只记一条（@@unique），重复举报幂等更新原因。
model CirclePostReport {
  id           String             @id @default(uuid())
  postID       String
  reporterID   String
  reason       String?
  status       ReportReviewStatus @default(PENDING)
  reviewedByID String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  // review 修复：同 GroupReport —— PENDING 局部唯一，审结后可重新举报。
  @@index([postID, reporterID])
  @@index([postID])
  @@index([status, createdAt])
}

model CollaborationRecognition {
  id           String    @id @default(uuid())
  recipientID  String
  recognizerID String
  circlePostID String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  recipient  User        @relation("collaborationRecognitionRecipient", fields: [recipientID], references: [id], onDelete: Cascade)
  recognizer User        @relation("collaborationRecognitionRecognizer", fields: [recognizerID], references: [id], onDelete: Cascade)
  circlePost CirclePost? @relation(fields: [circlePostID], references: [id], onDelete: SetNull)

  @@unique([circlePostID, recipientID])
  @@index([recipientID, revokedAt])
  @@index([recognizerID, createdAt])
  @@index([circlePostID])
}

model CircleInvitation {
  id            String                 @id @default(uuid())
  circleID      String
  applicantID   String
  inviterID     String
  /// 默认值只在「迁移已落地、旧色还没换掉」的发布窗口里有意义:新代码两条
  /// 建单路径都显式写入 Circle.requiredVerifierCount 的快照。
  requiredCount Int                    @default(1)
  approvedCount Int                    @default(0)
  status        CircleInvitationStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  circle        Circle                     @relation(fields: [circleID], references: [id], onDelete: Cascade)
  applicant     User                       @relation("invitationApplicant", fields: [applicantID], references: [id], onDelete: Cascade)
  inviter       User                       @relation("invitationInviter", fields: [inviterID], references: [id], onDelete: Cascade)
  verifiers     CircleInvitationVerifier[]
  notifications Notification[]

  @@index([circleID, status])
  @@index([applicantID])
}

model CircleInvitationVerifier {
  id           String                         @id @default(uuid())
  invitationID String
  verifierID   String
  addedByID    String
  status       CircleInvitationVerifierStatus @default(PENDING)
  respondedAt  DateTime?
  /// 验证邀请卡片的投递状态。席位提交后由 addVerifier 就地签发并置位；
  /// 失败(聊天侧抖动/对端会话解析失败)留空，由 sweepUndeliveredVerificationCards
  /// 逐轮补投。与 CoinGift 的 cardDeliveredAt/cardAttempts 同构 —— 差别是那张卡
  /// 是收款方拿到钱的唯一凭证，这张卡之外还有站内通知与待验证列表两条通道。
  cardDeliveredAt DateTime?
  cardAttempts    Int                         @default(0)
  createdAt    DateTime                       @default(now())

  invitation CircleInvitation @relation(fields: [invitationID], references: [id], onDelete: Cascade)
  verifier   User             @relation("verifierUser", fields: [verifierID], references: [id], onDelete: Cascade)
  addedBy    User             @relation("verifierAddedBy", fields: [addedByID], references: [id], onDelete: Cascade)
  // 待补卡片的局部索引（WHERE "cardDeliveredAt" IS NULL）在迁移
  // 20260811120000 里用原生 SQL 建 —— Prisma schema 无法表达 partial index。

  @@unique([invitationID, verifierID])
  @@index([verifierID, status])
}

enum TempChatStatus {
  ACTIVE
  ENDED
  EXPIRED
}

model TempChat {
  id                      String         @id @default(uuid())
  groupId                 String         @unique
  hostUserId              String
  title                   String         @default("临时聊天")
  status                  TempChatStatus @default(ACTIVE)
  maxMembers              Int            @default(50)
  expiresAt               DateTime
  endedAt                 DateTime?
  cleanupLockedAt         DateTime?
  cleanupGroupDismissedAt DateTime?
  cleanupCompletedAt      DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  guests TempChatGuest[]

  @@index([status, expiresAt])
  @@index([hostUserId])
}

model TempChatGuest {
  id                   String    @id @default(uuid())
  tempChatId           String
  imUserId             String    @unique
  displayName          String
  createdAt            DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
  cleanedUp            Boolean   @default(false)
  provisioningFailedAt DateTime?

  tempChat TempChat @relation(fields: [tempChatId], references: [id], onDelete: Cascade)

  @@index([tempChatId])
}

model EmailVerificationCode {
  id         String           @id @default(cuid())
  email      String
  codeHash   String
  purpose    EmailCodePurpose
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([email, purpose])
}

/// 用户对用户的点赞：每人对同一目标「每天」最多一条（likedOn 为日期，唯一约束防当日重复）。
/// 被赞总数累计在 User.receivedLikeCount，达阈值发放合作达人徽章。
model UserLike {
  id         String   @id @default(uuid())
  fromUserID String
  toUserID   String
  likedOn    DateTime @db.Date
  createdAt  DateTime @default(now())

  fromUser User @relation("userLikesGiven", fields: [fromUserID], references: [id], onDelete: Cascade)
  toUser   User @relation("userLikesReceived", fields: [toUserID], references: [id], onDelete: Cascade)

  @@unique([fromUserID, toUserID, likedOn])
  @@index([toUserID])
  // Composite backs the per-day quota count (WHERE fromUserID = ? AND likedOn = ?);
  // its fromUserID prefix also serves any fromUserID-only lookup.
  @@index([fromUserID, likedOn])
}

/// 聊天敏感词词表（chat.service 发送前进程内检查用）。word 存规范形态
/// （NFKC + 小写 + 裁剪，见 sensitive-word.matcher.ts），入库前由服务层统一规范化。
/// createdBy 只作审计参考，不建外键 —— 管理员账号删除不应连带删词。
model SensitiveWord {
  id        String   @id @default(uuid())
  word      String   @unique
  createdAt DateTime @default(now())
  createdBy String?
}

// ===== 自研聊天（替代 OpenIM，src/chat）=====

/// 会话类型：单聊 / 圈子群聊 / 临时群 / 客服。
enum ChatConversationType {
  DIRECT
  GROUP
  TEMP
  SUPPORT
}

/// 聊天会话。消息序协议参考 squady：每会话维护单调递增 height 序号，
/// 排序、已读水位、增量补拉共用同一坐标系。
/// userID 类字段一律不建 User 外键 —— 聊天行是高频写入的历史数据，
/// 不随账号删除级联清除（保留群聊上下文；同 SensitiveWord.createdBy 先例）。
model ChatConversation {
  id         String               @id @default(uuid())
  type       ChatConversationType
  /// DIRECT 会话防重键：两个 userID 升序以 ':' 拼接；其余类型为 null。
  directKey  String?              @unique
  /// GROUP 会话 ←→ Circle.id（一圈一群）；TEMP 会话 ←→ TempChat.id。
  circleID   String?              @unique
  tempChatID String?              @unique
  /// 会话列表排序依据；发送事务内更新。
  lastMessageAt DateTime?
  /// 管理台群禁言（全员禁言，圈主/管理员豁免）；null=未禁言。
  muteAllAt     DateTime?
  /// 会话级阅后即焚秒数（S-01）：任一方设置双方生效；null=关。到期由 sweeper 真删。
  burnDurationSec Int?
  /// height 计数器（G-05）：最后已分配的 height。取号 = SELECT..FOR UPDATE 行锁下 +1；
  /// 迁移时必须回填成 MAX(height)，默认 0 会撞 (conversationID, height) 唯一约束。
  nextHeight Int @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  members  ChatMember[]
  messages ChatMessage[]
}

/// 会话成员。成员行的存在即成员资格（发送/收取的授权来源）；
/// pinned/muted 是每成员的会话偏好（原 OpenIM 会话属性）。
model ChatMember {
  id             String    @id @default(uuid())
  conversationID String
  userID         String
  /// 已读水位：该成员已读的最大 height，只前进不后退。
  lastReadHeight Int       @default(0)
  /// 送达水位（G-07）：客户端收到 chat:msg 后回报的最大 height；只前进。
  lastDeliveredHeight Int  @default(0)
  /// 清空聊天记录水位（G-14）：本人只看得到 height 大于该值的消息；只前进。
  clearedBeforeHeight Int  @default(0)
  pinned         Boolean   @default(false)
  muted          Boolean   @default(false)
  /// 从列表隐藏(swipe hide);新消息落库时清空,会话重新浮出(微信式语义)。
  hiddenAt       DateTime?
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  conversation ChatConversation @relation(fields: [conversationID], references: [id], onDelete: Cascade)

  @@unique([conversationID, userID])
  @@index([userID])
}

/// 聊天消息。height 在发送事务内于 pg_advisory_xact_lock 下分配，
/// (conversationID, height) 唯一约束兜底乱序；
/// (conversationID, senderID, clientMessageId) 唯一约束兜底断线重发幂等。
model ChatMessage {
  id              String   @id @default(uuid())
  conversationID  String
  height          Int
  /// 发送者 userID；系统消息为 null。
  senderID        String?
  /// 消息类型（text/image/voice/… 与各类卡片），content 形状随 type 而定。
  type            String
  content         Json
  /// 客户端幂等键；系统消息为 null（null 不参与唯一约束冲突）。
  clientMessageId String?  @db.VarChar(128)
  replyToID       String?
  deleted         Boolean  @default(false)
  /// 撤回时间；撤回的消息仍占 height（坐标系不塌陷），content 已清空。
  revokedAt       DateTime?
  /// 执行撤回的人（发送者本人或圈主/管理员）。
  revokedBy       String?
  /// 编辑时间（G-07）；仅发送者、仅 text/quote、时间窗内。height 不变。
  editedAt        DateTime?
  /// 编辑前的历史 content 数组（留痕，不外发）。
  contentHistory  Json?
  createdAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationID], references: [id], onDelete: Cascade)
  reactions    ChatMessageReaction[]

  @@unique([conversationID, height])
  @@unique([conversationID, senderID, clientMessageId])
  // 按日期查聊天记录（chat-history 模块 Phase 2 将从 OpenIM 迁到此索引）。
  @@index([conversationID, createdAt])
  /// 重连追平（GET /chat/messages/mutations）按变更时刻扫。没有这两条的话，
  /// 高频群里每次重连都要全表扫那个会话的整段历史，只为捞出几条撤回/编辑。
  /// 查询里的粗筛写成 `revokedAt >= x OR editedAt >= x` 正是为了走它们
  /// （GREATEST 表达式本身走不了索引，只用于排序与游标）。
  @@index([conversationID, revokedAt])
  @@index([conversationID, editedAt])
}

/// 消息表情回应（G-07）。不进 height 坐标系：不是消息、不推进未读、
/// 不改 lastMessageAt；emoji 收白名单（服务端校验），同人同 emoji 唯一。
/// 待删除的聊天媒体对象(撤回 / 焚毁的配套物删)。
///
/// 为什么要持久化:消息行的 content 在撤回/焚毁那一刻就清空了,object key
/// 从此**没有任何业务数据能重建**。删除只在进程内存里重试的话,存储侧一次
/// 超过重试次数的故障、或者一次普通的重启,那个 key 就永远丢了 ——
/// 被撤回的图片继续留在桶里,而 StorageAudit 只报告孤儿、不删。
model ChatMediaDeletion {
  id        String   @id @default(uuid())
  /// object storage key（只收 chat/ 前缀）。
  objectKey String   @unique
  attempts  Int      @default(0)
  /// 最近一次失败原因（排障用，不外发）。
  lastError String?
  /// 下次可重试时刻（指数退避）。
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([nextAttemptAt])
}

model ChatMessageReaction {
  id        String   @id @default(uuid())
  messageID String
  userID    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageID], references: [id], onDelete: Cascade)

  @@unique([messageID, userID, emoji])
  @@index([messageID])
}
