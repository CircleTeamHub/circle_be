# --- build stage ----------------------------------------------------------
FROM node:22-slim AS build-stage

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
# The migrate service runs the lockfile-installed Prisma binary from this stage.
# Pin npm so dependency installation stays reproducible while this build-only
# stage exists.
RUN npm install -g npm@12.0.2 --no-audit --no-fund
# npm ci also runs the postinstall `prisma generate` step.
RUN npm ci

COPY . .
RUN npm run build

# --- production stage -----------------------------------------------------
FROM node:22-slim AS production-stage

ENV NODE_ENV=production
WORKDIR /app

# Prisma detects the OpenSSL ABI at runtime for migrations and query engines.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

# Run as non-root.
RUN groupadd --system app && useradd --system --gid app --shell /usr/sbin/nologin app

COPY --from=build-stage --chown=app:app /app/package.json /app/package-lock.json ./
COPY --from=build-stage --chown=app:app /app/node_modules ./node_modules
COPY --from=build-stage --chown=app:app /app/dist ./dist
COPY --from=build-stage --chown=app:app /app/prisma ./prisma
COPY --from=build-stage --chown=app:app /app/prisma.config.ts ./
COPY --from=build-stage --chown=app:app /app/src/generated ./src/generated

# Drop devDependencies, then restore just the lockfile-pinned Prisma CLI.
# Migrations execute its local binary directly, so the final image can remove
# npm/npx after the build and keep the server fully offline during deployment.
# Installing Prisma here also fetches its schema engine through postinstall.
RUN npm prune --omit=dev \
    && npm install --no-save --omit=dev \
        "prisma@$(node -p "require('./package-lock.json').packages['node_modules/prisma'].version")" \
    && ./node_modules/.bin/prisma --version \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

USER app

EXPOSE 3000

CMD ["node", "dist/src/main.js"]
