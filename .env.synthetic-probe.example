# 只读合成探测（monitoring/synthetic-probe/probe.mjs）的配置。
# 复制成仓库根目录的 .env.synthetic-probe（chmod 600，不进 git），然后在仓库根目录用
# 监控栈当初启动时的同一组 compose 文件拉起（开了日志 overlay 的机器要带上它）：
#   docker compose -f monitoring/docker-compose.yml -f monitoring/docker-compose.prod.yml up -d synthetic-probe
# 步骤与注意事项见 docs/observability.md「只读合成探测」。

# 公网 API 地址，与用户 App 连的是同一个（只接受 https://）。
PROBE_BASE_URL=https://api.example.com

# 专用测试号：普通用户（USER / MEMBER），不要用管理员账号，也不要拿真人的号。
PROBE_IDENTIFIER=
PROBE_PASSWORD=

# 探测用的固定设备号，16–128 位字母、数字、- 或 _。生成：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 一旦用过就别换：换了就是一台新设备，登录会要已信任设备批准。
PROBE_DEVICE_ID=

# 每轮间隔（秒，60–300）和每一步的超时（毫秒，最多 30000）。超出的值会被收回到上限。
PROBE_INTERVAL_SECONDS=300
PROBE_TIMEOUT_MS=10000
