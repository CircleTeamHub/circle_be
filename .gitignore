.idea/
.vscode/
node_modules/
build/
tmp/
temp/
dist/
/logs/

# Environment variables — never commit secrets. Use .env.example as the
# tracked template, keep concrete values out of version control.
.env
.env.*
!.env.example
!.env.production.example
!.env.backup.example
# General
.DS_Store
.AppleDouble
.LSOverride

# macOS 自定义图标文件,真名是 "Icon" 后跟两个 \r。裸写 Icon 会在大小写不敏感的
# 文件系统(Windows/macOS)上误伤 src/icon/ 整个目录 —— git 大小写敏感不受影响,
# 但 prettier 默认拿 .gitignore 当忽略清单,会静默跳过该目录、只在 Linux CI 才报错。
Icon[\r]

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
src/generated/
.claude/
coverage/
